{
  "$schema": "https://lovable.dev/schemas/project-blueprint.v1.json",
  "name": "app-preview-helper",
  "description": "Target directory layout for the platform. Source of truth for future refactors — an agent can diff the live tree against this file to know what to move next.",
  "generatedAt": "2026-07-21",
  "stack": {
    "framework": "TanStack Start v1 (React 19, Vite 7)",
    "styling": "Tailwind CSS v4",
    "routing": "TanStack Router file-based (src/routes)",
    "data": "TanStack Query",
    "backend": "Lovable Cloud (Supabase)",
    "orm": "Drizzle (schema-only, generated types)",
    "i18n": "i18next + react-i18next"
  },
  "conventions": {
    "routeNaming": "Dot-separated flat filenames map to slashes. `_auth` and `_dashboard` are pathless layout groups.",
    "layoutGroups": {
      "_auth": "AuthLayout wraps login/signup",
      "_dashboard": "DashboardLayout wraps every authenticated route (replaces current `_authenticated`)"
    },
    "featureSlicing": "Each feature owns its own components/ + hooks/ (+ optional route/, trades/).",
    "serverFunctions": "*.functions.ts co-located with the feature that owns them (imported by client), *.server.ts is server-only.",
    "autoGenerated": ["src/routeTree.gen.ts", "src/integrations/supabase/*"]
  },
  "tree": {
    "src": {
      "api": {
        "db": { "schema.ts": "Drizzle schema" },
        "routers": {
          "auth.ts": "signup / login",
          "jobs.ts": "post/view/manage jobs",
          "profile.ts": "create/update profiles",
          "team.ts": "invite/manage staff",
          "timesheets.ts": "log/retrieve hours"
        }
      },
      "components": {
        "layouts": {
          "AuthLayout.tsx": "wraps login/signup",
          "DashboardLayout.tsx": "wraps app after login"
        },
        "shared": {
          "PageHeader.tsx": "consistent titles",
          "UserAvatar.tsx": "profile picture"
        },
        "ui": {
          "__note__": "shadcn primitives (Button, Card, Input, …)"
        }
      },
      "features": {
        "auth": {
          "components": ["LoginForm.tsx", "SignupForm.tsx"],
          "hooks": ["useAuth.ts"]
        },
        "contractor": {
          "dashboard": { "components": ["ContractorDashboard.tsx"] },
          "jobs": { "components": ["JobFeed.tsx", "JobDetails.tsx"] },
          "onboarding": { "components": ["OnboardingWizard.tsx"] },
          "profile": {
            "components": ["ContractorProfilePage.tsx", "DynamicProfileSection.tsx"],
            "trades": ["ArchitectTools.tsx", "SiteSecurityTools.tsx"]
          },
          "team": {
            "components": ["TeamDashboardPage.tsx", "InviteStaffForm.tsx"],
            "hooks": ["useTeamMembers.ts"]
          },
          "timesheets": {
            "components": ["LogHoursPage.tsx", "LocationInput.tsx"],
            "hooks": ["useLocation.ts"]
          },
          "tools": {
            "components": ["KmTrackerSheet.tsx", "SmartReceiptsSheet.tsx"],
            "hooks": ["useOcr.ts"]
          }
        },
        "homeowner": {
          "dashboard": { "components": ["HomeownerDashboard.tsx"] },
          "jobs": {
            "components": ["PostJobWizard.tsx", "MyProjectsList.tsx", "ViewBids.tsx"],
            "hooks": ["useMyProjects.ts"]
          },
          "messages": { "components": ["ChatView.tsx"] },
          "payments": { "components": ["PaymentHistory.tsx"] },
          "profile": { "components": ["HomeownerProfilePage.tsx"] }
        },
        "shared": {
          "notifications": { "components": ["NotificationFeed.tsx"] }
        }
      },
      "hooks": { "useUser.ts": "current user + role" },
      "i18n": {
        "locales": { "en.json": "", "de.json": "" },
        "config.ts": "i18next config"
      },
      "lib": {
        "permissions.ts": "RBAC",
        "supabase.ts": "client init",
        "types.ts": "shared TS types",
        "utils.ts": "cn() etc."
      },
      "regions": {
        "config.ts": "select active region",
        "germany.ts": "DE trades + regulations",
        "index.ts": "exports current region"
      },
      "routes": {
        "__root.tsx": "root layout",
        "index.tsx": "public landing",
        "_auth": ["login.tsx", "signup.tsx"],
        "_dashboard": {
          "contractor": ["index.tsx", "jobs.tsx", "profile.tsx", "team.tsx", "timesheets.tsx"],
          "homeowner": ["index.tsx", "jobs.tsx", "profile.tsx"]
        },
        "onboarding": ["profile.tsx"]
      }
    }
  }
}
