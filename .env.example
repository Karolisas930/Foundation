# ---------------------------------------------------------------------------
# Chameleon — Environment variables template
#
# Copy to `.env` (git-ignored) for local dev. Never commit real values.
# In hosted environments (Lovable Cloud / Cloudflare Workers), set these via
# the secrets tooling — do NOT ship a populated .env to production.
# ---------------------------------------------------------------------------

# --- Public (browser-visible) ---------------------------------------------
# Injected at build time by Vite. Safe to expose — publishable keys only.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# --- Server-only (never exposed to the browser) ---------------------------
# Read inside server functions / route handlers via process.env.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# Direct Postgres connection (migrations, admin scripts).
SUPABASE_DB_URL="postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
# Pooled connection (Supavisor / PgBouncer) — use for serverless / edge runtimes.
SUPABASE_POOLER_URL="postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- App configuration -----------------------------------------------------
APP_BASE_URL="http://localhost:8080"
NODE_ENV="development"

# --- Lovable platform ------------------------------------------------------
# Managed by Lovable in hosted envs; only needed locally when hitting the AI gateway.
LOVABLE_API_KEY=""

# --- Optional integrations (uncomment as adopted) --------------------------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# RESEND_API_KEY=""
# OPENAI_API_KEY=""